# Copy to .env and fill in. Never commit .env.

# --- Jira ---
JIRA_BASE_URL=https://yourname.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=

# --- GitHub (fine-grained PAT: Contents RW, Pull requests RW, Metadata R) ---
GITHUB_TOKEN=
GITHUB_REPO=your-github-user/your-test-repo

# --- LLM (Aider picks the key up from env) ---
GEMINI_API_KEY=
AIDER_MODEL=gemini/gemini-2.5-flash
# Groq alternative:  GROQ_API_KEY=...  AIDER_MODEL=groq/llama-3.3-70b-versatile
# OpenRouter free:   OPENROUTER_API_KEY=...  AIDER_MODEL=openrouter/<model>:free

# --- Webhook ---
# Any long random string. Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=

# --- Behaviour ---
TRIGGER_LABEL=ai-agent
OPEN_DRAFT_PR=true

# Aider edit mode: "diff" edits only the needed lines; "whole" rewrites entire files
AIDER_EDIT_FORMAT=diff
